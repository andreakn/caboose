{
  "name": "caboose",
  "version": "1.0.0",
  "description": "Caboose: run coding agents (Claude Code, GitHub Copilot) side by side in git worktrees",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "test": "node --test --test-force-exit test/",
    "typecheck": "tsc -p .",
    "spike": "node spike/phase0.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@github/copilot-sdk": "^1.0.28",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "fsevents": false,
    "koffi": false
  },
  "productName": "Caboose",
  "main": "out/main/index.js"
}
